# Copy this file to application-local.yml (git-ignored) and fill in local secrets.
# Everything here overrides application.yml.

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/dsh_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: change-me
  data:
    redis:
      host: localhost
      port: 6381

# Print SQL statements while developing (off by default)
mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

dsh:
  cors:
    # Front-end origins allowed to call the API. Wildcards allowed. Narrow this in production.
    origins: http://localhost:*,http://127.0.0.1:*
  jwt:
    # REQUIRED, at least 32 bytes. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
    secret: replace-with-a-long-random-string-of-at-least-32-bytes
  ai:
    # Optional. When empty, the rule-based solution generator is used instead of the LLM.
    api-key: ${DSH_AI_API_KEY:}
    model: deepseek-chat
    base-url: https://api.deepseek.com
